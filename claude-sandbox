#!/usr/bin/env bash
# claude-sandbox [options] [claude args ...] - run Claude Code in a throwaway container.
#   --disable-host-ssh-agent-forwarding   do not forward the host SSH agent into the container
#   --disable-host-claude-config-mapping  do not mount the host ~/.claude and ~/.claude.json
# Any other arguments are passed through to `claude`. Options only apply when a container is created.
set -euo pipefail

# Docker build context: the Dockerfile and entrypoint installed by install.sh.
script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
sandbox_dir="$script_dir/../share/claude-sandbox"
if [ ! -f "$sandbox_dir/Dockerfile" ]; then
  echo "claude-sandbox: $sandbox_dir/Dockerfile not found; install with install.sh." >&2
  exit 1
fi

# Both features are on by default; our own flags are consumed here and the
# remaining arguments are what gets passed to claude.
ssh_agent=1
map_claude=1
claude_args=()
for arg in "$@"; do
  case "$arg" in
    --disable-host-ssh-agent-forwarding) ssh_agent=0 ;;
    --disable-host-claude-config-mapping) map_claude=0 ;;
    *) claude_args+=("$arg") ;;
  esac
done
set -- ${claude_args[@]+"${claude_args[@]}"}

# Docker creates a directory at a missing bind source, which would break ~/.claude.json.
if [ "$map_claude" = 1 ]; then
  mkdir -p "$HOME/.claude"
  [ -f "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"
fi

# Identify this folder's container: readable name plus a hash of the canonical
# path so different folders sharing a basename don't collide.
canon_pwd="$(pwd -P)"
basename_sanitized="$(basename "$canon_pwd" | tr -c 'a-zA-Z0-9_.-' '-')"
hash="$(printf '%s' "$canon_pwd" | sha256sum | cut -c1-8)"
container_name="claude-sandbox-${basename_sanitized}-${hash}"

# Quote each argument so values with spaces survive the trip through tmux.
cmd="exec claude --dangerously-skip-permissions"
for arg in "$@"; do cmd+=" $(printf '%q' "$arg")"; done

if docker container inspect "$container_name" >/dev/null 2>&1; then
  existing=1
else
  existing=0
fi

if [ "$existing" -eq 1 ] && [ "$#" -gt 0 ]; then
  read -rp "A container already exists for this folder ($container_name). Remove it and start fresh with the new arguments? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    docker rm -f "$container_name" >/dev/null
    existing=0
  else
    echo "Reusing existing container; the new arguments will be ignored for this run." >&2
  fi
fi

if [ "$existing" -eq 1 ]; then
  if [ "$(docker inspect -f '{{.State.Running}}' "$container_name")" = "true" ]; then
    exec docker attach "$container_name"
  else
    exec docker start -ai "$container_name"
  fi
fi

# Defaults to the current stable release; set CLAUDE_CODE_VERSION to pin one.
# A new version changes the image tag, so the next launch rebuilds the image.
# Resolved only when a container has to be created, so reattaching works offline.
pinned=true
if [ -z "${CLAUDE_CODE_VERSION:-}" ]; then
  pinned=false
  CLAUDE_CODE_VERSION="$(curl -fsSL --max-time 5 https://downloads.claude.ai/claude-code-releases/stable 2>/dev/null || true)"
  if [[ ! "$CLAUDE_CODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "claude-sandbox: could not determine the latest stable Claude Code version; set CLAUDE_CODE_VERSION=x.y.z to pin one." >&2
    exit 1
  fi
fi
image="claude-sandbox:${CLAUDE_CODE_VERSION}"

# A pinned version stays pinned; otherwise Claude Code may update itself.
updater_env=()
$pinned && updater_env=(-e DISABLE_AUTOUPDATER=1)

docker image inspect "$image" >/dev/null 2>&1 || docker build \
  --build-arg "CLAUDE_CODE_VERSION=$CLAUDE_CODE_VERSION" \
  -t "$image" "$sandbox_dir"

run_args=()
if [ "$map_claude" = 1 ]; then
  run_args+=(-v "$HOME/.claude:$HOME/.claude" -v "$HOME/.claude.json:$HOME/.claude.json")
fi
if [ "$ssh_agent" = 1 ]; then
  if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    run_args+=(-v "$SSH_AUTH_SOCK:/run/ssh-agent.sock" -e SSH_AUTH_SOCK=/run/ssh-agent.sock)
  else
    echo "claude-sandbox: no SSH agent found (SSH_AUTH_SOCK); continuing without agent forwarding." >&2
  fi
fi

# $PWD is the directory you invoked this from: mounted at the same path, and the workdir.
# The container starts as root; entrypoint.sh creates/matches the host user
# below and drops privileges, so the image stays portable across host users.
exec docker run -it \
  --name "$container_name" \
  --workdir "$PWD" \
  -v "$PWD:$PWD" \
  ${run_args[@]+"${run_args[@]}"} \
  -e "TERM=${TERM:-xterm-256color}" \
  -e "HOST_USER=$(id -un)" \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "HOST_HOME=$HOME" \
  ${updater_env[@]+"${updater_env[@]}"} \
  "$image" \
  tmux -u new bash -c "$cmd"
