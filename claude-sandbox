#!/usr/bin/env bash
# claude-sandbox [claude args ...] - run Claude Code in a throwaway container.
set -euo pipefail

# Bump to pin a new release; the next launch rebuilds the image.
CLAUDE_CODE_VERSION="${CLAUDE_CODE_VERSION:-2.1.233}"

# Where the Dockerfile lives (this script's directory), used only as the build context.
sandbox_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

image="claude-sandbox:${CLAUDE_CODE_VERSION}"

# Docker creates a directory at a missing bind source, which would break ~/.claude.json.
mkdir -p "$HOME/.claude"
[ -f "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"

# Identify this folder's container: readable name plus a hash of the canonical
# path so different folders sharing a basename don't collide.
canon_pwd="$(pwd -P)"
basename_sanitized="$(basename "$canon_pwd" | tr -c 'a-zA-Z0-9_.-' '-')"
hash="$(printf '%s' "$canon_pwd" | sha256sum | cut -c1-8)"
container_name="claude-sandbox-${basename_sanitized}-${hash}"

# Quote each argument so values with spaces survive the trip through tmux.
cmd="claude"
for arg in "$@"; do cmd+=" $(printf '%q' "$arg")"; done

if docker container inspect "$container_name" >/dev/null 2>&1; then
  existing=1
else
  existing=0
fi

if [ "$existing" -eq 1 ] && [ "$#" -gt 0 ]; then
  read -rp "A container already exists for this folder ($container_name). Remove it and start fresh with the new arguments? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    docker rm -f "$container_name" >/dev/null
    existing=0
  else
    echo "Reusing existing container; the new arguments will be ignored for this run." >&2
  fi
fi

if [ "$existing" -eq 1 ]; then
  if [ "$(docker inspect -f '{{.State.Running}}' "$container_name")" = "true" ]; then
    exec docker attach "$container_name"
  else
    exec docker start -ai "$container_name"
  fi
fi

docker image inspect "$image" >/dev/null 2>&1 || docker build \
  --build-arg "CLAUDE_CODE_VERSION=$CLAUDE_CODE_VERSION" \
  -t "$image" "$sandbox_dir"

# $PWD is the directory you invoked this from: mounted at the same path, and the workdir.
# The container starts as root; entrypoint.sh creates/matches the host user
# below and drops privileges, so the image stays portable across host users.
exec docker run -it \
  --name "$container_name" \
  --workdir "$PWD" \
  -v "$PWD:$PWD" \
  -v "$HOME/.claude:$HOME/.claude" \
  -v "$HOME/.claude.json:$HOME/.claude.json" \
  -e "TERM=${TERM:-xterm-256color}" \
  -e "HOST_USER=$(id -un)" \
  -e "HOST_UID=$(id -u)" \
  -e "HOST_GID=$(id -g)" \
  -e "HOST_HOME=$HOME" \
  "$image" \
  tmux -u new "$cmd"
